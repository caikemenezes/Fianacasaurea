DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=financas_php
DB_USER=root
DB_PASS=

# "1" em produção (exige HTTPS pro cookie de sessão), vazio/"0" em ambiente local
APP_SECURE_COOKIE=0

# "1" só em ambiente local, pra ver erros de PHP na tela. Deixe vazio/"0" (ou
# nem defina) em produção — com isso desligado, erros só vão pro log do servidor.
APP_DEBUG=0

# Chave pra cifrar segredos no banco (hoje só a senha de app do Gmail de cada
# família, cadastrada em Configurações > Extrato automático — ver src/cripto.php).
# Gere UMA vez com: php -r "echo base64_encode(random_bytes(32));"
# Nunca troque depois de já ter segredos salvos — eles ficam ilegíveis com uma
# chave diferente da que cifrou.
APP_ENCRYPTION_KEY=
